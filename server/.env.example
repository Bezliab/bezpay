# Copy this file to .env and provide your local values.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bezpay
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=


NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bezpay

# sandbox | live
MONNIFY_ENV=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=      # used in Phase 3 for payouts
MONNIFY_VALIDATE_PATH=/api/v1/disbursements/account/validate

# Fees (verify against your Monnify contract)
INFLOW_FEE_BPS=150                  # 1.50%
INFLOW_FEE_CAP_NGN=2000
BEZPAY_FEE_FLAT_NGN=100
BEZPAY_FEE_BPS=0

MIN_AMOUNT_NGN=100
MAX_AMOUNT_NGN=5000000
TX_EXPIRY_MINUTES=40